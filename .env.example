# Ключ Claude API: https://console.anthropic.com/settings/keys
# Без ключа приложение работает в демо-режиме (шаблонное КП без ИИ).
ANTHROPIC_API_KEY=

# Модель Claude (необязательно). По умолчанию claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Сколько генераций в минуту разрешено с одного IP (необязательно). По умолчанию 5.
RATE_LIMIT_PER_MINUTE=5
